PORT=4100
MAX_CONCURRENT_SESSIONS=100
BROWSER_HOUR_ALLOWANCE=500
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUBLIC_BASE_URL=http://localhost:4100

# Protects local APIs and optionally POST /api/run
STRATUS_API_KEY=sk_stratus_dev_change_me

# Employer submission release controls. Correlation accepts only compat or required.
# A missing correlation mode also defaults to required.
STRATUS_SUBMISSION_CORRELATION_MODE=required

# Set exactly 1 to quiesce employer-bound work. Unset or any non-1 value remains live.
# STRATUS_SUBMISSION_QUIESCED=1
