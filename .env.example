PORT=4100
MAX_CONCURRENT_SESSIONS=100
BROWSER_HOUR_ALLOWANCE=500
CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUBLIC_BASE_URL=http://localhost:4100

# Server-only token from https://cloud.browserless.io
BROWSERLESS_TOKEN=

# Optional custom Browserless regional endpoint
BROWSERLESS_ENDPOINT=https://production-sfo.browserless.io

# Protects local APIs and optionally POST /api/run
STRATUS_API_KEY=sk_stratus_dev_change_me
