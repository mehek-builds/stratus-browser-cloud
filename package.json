{
  "name": "stratus-browser-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A clean-room browser-agent cloud with self-hosted and free managed modes.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "test:runner": "NODE_ENV=test node test/managed-runner-replay.mjs",
    "test:security-code": "NODE_ENV=test node test/security-code-replay.mjs",
    "test:required-confirmation": "NODE_ENV=test node test/required-confirmation-replay.mjs",
    "test:e2e": "NODE_ENV=test node test/e2e.mjs",
    "verify": "npm test && npm run test:runner && npm run test:security-code && npm run test:required-confirmation && npm run test:captcha-visibility && npm run test:e2e",
    "dev:vercel": "vercel dev",
    "test:captcha-visibility": "NODE_ENV=test node test/captcha-visibility-replay.mjs"
  },
  "dependencies": {
    "@vercel/sandbox": "^2.8.0",
    "jose": "^6.2.4",
    "playwright-core": "^1.54.1",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22"
  }
}
